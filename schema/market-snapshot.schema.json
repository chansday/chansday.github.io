{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chansday.github.io/schema/market-snapshot.schema.json",
  "title": "KOSPI signal board snapshot",
  "description": "Static snapshot contract for expected and actual KOSPI observation values.",
  "type": "object",
  "required": ["schemaVersion", "status", "mode", "market", "provider", "pipeline", "rows", "meta"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "status": { "enum": ["ready", "demo", "no_data", "partial", "degraded", "blocked", "pending"] },
    "mode": { "enum": ["provider", "demo", "fixture", "replay", "backfill_test", "historical_test"] },
    "asOfDate": { "type": ["string", "null"], "format": "date" },
    "publishedAt": { "type": ["string", "null"], "format": "date-time" },
    "market": {
      "type": "object",
      "required": ["name", "currency", "timezone"],
      "properties": {
        "name": { "const": "KOSPI" },
        "currency": { "const": "KRW" },
        "timezone": { "const": "Asia/Seoul" }
      },
      "additionalProperties": false
    },
    "baseline": {
      "type": "object",
      "required": ["basis", "reference_date", "value_status", "note"],
      "properties": {
        "basis": { "type": "string" },
        "reference_date": { "type": "string", "format": "date" },
        "input_through_date": { "type": "string", "format": "date" },
        "value_status": { "type": "string" },
        "formula": { "type": "string" },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "provider": {
      "type": ["object", "null"],
      "properties": {
        "id": { "type": ["string", "null"] },
        "status": { "type": "string" },
        "label": { "type": "string" },
        "source": { "$ref": "#/$defs/sourceMetadataOrNull" }
      },
      "required": ["status", "label", "source"],
      "additionalProperties": false
    },
    "pipeline": {
      "type": "object",
      "required": ["previousResult", "analysis", "forecast", "openSettlement", "closeSettlement"],
      "properties": {
        "previousResult": { "$ref": "#/$defs/pipelineStep" },
        "analysis": { "$ref": "#/$defs/pipelineStep" },
        "forecast": { "$ref": "#/$defs/pipelineStep" },
        "openSettlement": { "$ref": "#/$defs/pipelineStep" },
        "closeSettlement": { "$ref": "#/$defs/pipelineStep" }
      },
      "additionalProperties": false
    },
    "rows": { "type": "array", "items": { "$ref": "#/$defs/rankingRow" } },
    "meta": {
      "type": "object",
      "required": ["generatedBy", "lastAttemptAt", "lastAttemptMode", "blockedReason", "isDemo", "source"],
      "properties": {
        "generatedBy": { "type": "string" },
        "lastAttemptAt": { "type": ["string", "null"], "format": "date-time" },
        "lastAttemptMode": { "type": ["string", "null"] },
        "blockedReason": { "type": ["string", "null"] },
        "isDemo": { "type": "boolean" },
        "backfill": { "type": "boolean" },
        "backfill_source_replay_date": { "type": "string", "format": "date" },
        "backfill_note": { "type": "string" },
        "historical_test": { "type": "boolean" },
        "test_only": { "type": "boolean" },
        "actual_field_note": { "type": "string" },
        "source_collection_date": { "type": "string", "format": "date" },
        "source_range": { "type": "string" },
        "source_rows": { "type": "integer", "minimum": 0 },
        "source_raw_rows": { "type": "integer", "minimum": 0 },
        "replay_type": { "type": "string" },
        "replay_note": { "type": "string" },
        "fixture_note": { "type": "string" },
        "source": { "$ref": "#/$defs/sourceMetadataOrNull" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "sourceMetadata": {
      "type": "object",
      "required": ["name", "url", "license_status", "license_url", "retrieved_at"],
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "license_status": { "enum": ["confirmed", "unconfirmed", "unknown", "not_applicable"] },
        "license_url": { "type": ["string", "null"], "format": "uri-reference" },
        "retrieved_at": { "type": ["string", "null"], "format": "date-time" },
        "source_id": { "type": "string" },
        "run_id": { "type": "string" },
        "status": { "type": "string" },
        "fetched_at": { "type": "string", "format": "date-time" },
        "raw_rows": { "type": "integer", "minimum": 0 },
        "source_rows": { "type": "integer", "minimum": 0 },
        "partial": { "type": "boolean" },
        "metrics": {
          "type": "object",
          "properties": {
            "requested": { "type": "integer", "minimum": 0 },
            "completed": { "type": "integer", "minimum": 0 },
            "failed": { "type": "integer", "minimum": 0 },
            "retries": { "type": "integer", "minimum": 0 },
            "deadline_hit": { "type": "boolean" },
            "elapsed_ms": { "type": "number", "minimum": 0 },
            "estimated_ms": { "type": "number", "minimum": 0 },
            "overall_deadline_ms": { "type": "number", "minimum": 0 },
            "max_concurrency": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "sourceMetadataOrNull": { "anyOf": [{ "$ref": "#/$defs/sourceMetadata" }, { "type": "null" }] },
    "pipelineStep": {
      "type": "object",
      "required": ["status", "attemptedAt", "provider_id", "message"],
      "properties": {
        "status": { "type": "string" },
        "attemptedAt": { "type": ["string", "null"], "format": "date-time" },
        "provider_id": { "type": ["string", "null"] },
        "message": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "rankingRow": {
      "type": "object",
      "required": ["rank", "symbol", "name", "expected_open", "expected_close", "expected_return", "actual_open", "actual_close", "actual_return", "error", "status"],
      "properties": {
        "rank": { "type": ["integer", "null"], "minimum": 1 },
        "symbol": { "type": ["string", "null"] },
        "name": { "type": ["string", "null"] },
        "expected_open": { "type": ["number", "null"] },
        "expected_close": { "type": ["number", "null"] },
        "expected_return": { "type": ["number", "null"] },
        "actual_open": { "type": ["number", "null"] },
        "actual_close": { "type": ["number", "null"] },
        "actual_return": { "type": ["number", "null"] },
        "error": { "type": ["number", "null"] },
        "actual_volume": { "type": ["number", "null"], "minimum": 0 },
        "prior_close": { "type": ["number", "null"], "minimum": 0 },
        "confidence": { "type": ["number", "null"] },
        "quality": { "type": ["string", "null"] },
        "status": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
