{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chansday.github.io/schema/market-snapshot.schema.json",
  "title": "KOSPI signal board snapshot",
  "description": "Static snapshot contract for expected and actual KOSPI observation values.",
  "type": "object",
  "allOf": [{
    "if": { "properties": { "provider": { "type": "object", "required": ["id"], "properties": { "id": { "const": "naver-crawl" } } } }, "required": ["provider"] },
    "then": { "properties": { "rows": { "items": { "properties": { "symbol": { "type": "string", "minLength": 6, "maxLength": 6, "pattern": "^[0-9A-Z]{6}$" } }, "required": ["symbol"] } } } }
  }],
  "required": ["schemaVersion", "status", "mode", "market", "provider", "pipeline", "rows", "meta"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "status": { "enum": ["ready", "demo", "no_data", "partial", "degraded", "blocked", "pending"] },
    "mode": { "enum": ["provider", "demo", "fixture", "replay", "backfill_test", "historical_test"] },
    "asOfDate": { "type": ["string", "null"], "format": "date" },
    "publishedAt": { "type": ["string", "null"], "format": "date-time" },
    "market": {
      "type": "object",
      "required": ["name", "currency", "timezone"],
      "properties": {
        "name": { "const": "KOSPI" },
        "currency": { "const": "KRW" },
        "timezone": { "const": "Asia/Seoul" }
      },
      "additionalProperties": false
    },
    "baseline": {
      "type": "object",
      "required": ["basis", "reference_date", "value_status", "note"],
      "properties": {
        "basis": { "type": "string" },
        "reference_date": { "type": "string", "format": "date" },
        "input_through_date": { "type": "string", "format": "date" },
        "value_status": { "type": "string" },
        "model": { "type": "string" },
        "lookback_sessions": { "type": "integer", "minimum": 1 },
        "input_dates": { "type": "array", "items": { "type": "string", "format": "date" } },
        "coefficients": { "type": "object", "additionalProperties": { "type": "number" } },
        "formula": { "type": "string" },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "evaluation": { "$ref": "#/$defs/evaluationSummary" },
    "provider": {
      "type": ["object", "null"],
      "properties": {
        "id": { "type": ["string", "null"] },
        "status": { "type": "string" },
        "label": { "type": "string" },
        "source": { "$ref": "#/$defs/sourceMetadataOrNull" }
      },
      "required": ["status", "label", "source"],
      "additionalProperties": false
    },
    "pipeline": {
      "type": "object",
      "required": ["previousResult", "analysis", "forecast", "openSettlement", "closeSettlement"],
      "properties": {
        "previousResult": { "$ref": "#/$defs/pipelineStep" },
        "analysis": { "$ref": "#/$defs/pipelineStep" },
        "forecast": { "$ref": "#/$defs/pipelineStep" },
        "openSettlement": { "$ref": "#/$defs/pipelineStep" },
        "closeSettlement": { "$ref": "#/$defs/pipelineStep" }
      },
      "additionalProperties": false
    },
    "rows": { "type": "array", "items": { "$ref": "#/$defs/rankingRow" } },
    "meta": {
      "type": "object",
      "required": ["generatedBy", "lastAttemptAt", "lastAttemptMode", "blockedReason", "isDemo", "source"],
      "properties": {
        "generatedBy": { "type": "string" },
        "lastAttemptAt": { "type": ["string", "null"], "format": "date-time" },
        "lastAttemptMode": { "type": ["string", "null"] },
        "source_warning": { "type": ["string", "null"] },
        "run_date": { "type": "string", "format": "date" },
        "run_stage": { "type": "string", "enum": ["update-results", "analysis", "forecast", "open-settlement", "close-settlement"] },
        "blockedReason": { "type": ["string", "null"] },
        "isDemo": { "type": "boolean" },
        "backfill": { "type": "boolean" },
        "backfill_source_replay_date": { "type": "string", "format": "date" },
        "backfill_note": { "type": "string" },
        "historical_test": { "type": "boolean" },
        "test_only": { "type": "boolean" },
        "historical_fallback": { "type": "boolean" },
        "historical_fallback_reason": { "type": "string" },
        "historical_fallback_source": { "type": "string" },
        "live_snapshot_status": { "type": "string" },
        "live_provider_id": { "type": ["string", "null"] },
        "actual_field_note": { "type": "string" },
        "source_collection_date": { "type": "string", "format": "date" },
        "source_range": { "type": "string" },
        "source_rows": { "type": "integer", "minimum": 0 },
        "source_raw_rows": { "type": "integer", "minimum": 0 },
        "replay_type": { "type": "string" },
        "replay_note": { "type": "string" },
        "fixture_note": { "type": "string" },
        "data_classification": { "enum": ["operational", "test_only"] },
        "evaluation_dataset": { "enum": ["operational", "historical_test", "fixture", "replay", "backfill_test"] },
        "evaluation_test_only": { "type": "boolean" },
        "stage_test": { "type": "boolean" },
        "stage": { "type": "string", "pattern": "^\\d{4}$" },
        "stage_source": { "type": "string" },
        "latest_snapshot_untouched": { "type": "boolean" },
        "sequence_verification": { "type": "boolean" },
        "sequence": { "type": "array", "items": { "type": "string", "pattern": "^\\d{4}$" } },
        "applied_stage": { "type": "string", "pattern": "^\\d{4}$" },
        "source_stage_snapshot": { "type": "string" },
        "source": { "$ref": "#/$defs/sourceMetadataOrNull" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "sourceMetadata": {
      "type": "object",
      "required": ["name", "url", "license_status", "license_url", "retrieved_at"],
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "license_status": { "enum": ["confirmed", "unconfirmed", "unknown", "not_applicable"] },
        "license_url": { "type": ["string", "null"], "format": "uri-reference" },
        "retrieved_at": { "type": ["string", "null"], "format": "date-time" },
        "source_id": { "type": "string" },
        "run_id": { "type": "string" },
        "status": { "type": "string" },
        "fetched_at": { "type": "string", "format": "date-time" },
        "source_date": { "type": ["string", "null"], "format": "date" },
        "raw_rows": { "type": "integer", "minimum": 0 },
        "source_rows": { "type": "integer", "minimum": 0 },
        "partial": { "type": "boolean" },
        "metrics": {
          "type": "object",
          "properties": {
            "requested": { "type": "integer", "minimum": 0 },
            "completed": { "type": "integer", "minimum": 0 },
            "failed": { "type": "integer", "minimum": 0 },
            "retries": { "type": "integer", "minimum": 0 },
            "deadline_hit": { "type": "boolean" },
            "elapsed_ms": { "type": "number", "minimum": 0 },
            "estimated_ms": { "type": "number", "minimum": 0 },
            "overall_deadline_ms": { "type": "number", "minimum": 0 },
            "max_concurrency": { "type": "integer", "minimum": 1 },
            "max_age_seconds": { "type": "number", "minimum": 0 },
            "close_max_age_seconds": { "type": "number", "minimum": 0 },
            "quote_count": { "type": "integer", "minimum": 0 },
            "min_quote_age_seconds": { "type": ["number", "null"], "minimum": 0 },
            "max_quote_age_seconds": { "type": ["number", "null"], "minimum": 0 },
            "universe_endpoint": { "type": "string", "format": "uri" },
            "quote_endpoint_template": { "type": "string", "format": "uri-reference" },
            "delayed_data_possible": { "type": "boolean" },
            "source_basis": { "enum": ["naver-daily", "unknown"] },
            "security_type": { "const": "unknown" },
            "license_note": { "type": "string" },
            "history_status": { "enum": ["blocked", "degraded", "partial", "ready"] },
            "history_reason": { "type": "string" },
            "history_source": { "type": "string", "format": "uri" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "sourceMetadataOrNull": { "anyOf": [{ "$ref": "#/$defs/sourceMetadata" }, { "type": "null" }] },
    "evaluationSummary": {
      "type": "object",
      "required": ["status", "test_only", "dataset", "target", "display_policy", "sample_count", "evaluated_sample_count", "missing_sample_count", "evaluation_range", "metrics", "note"],
      "properties": {
        "status": { "enum": ["pending", "partial", "evaluated"] },
        "test_only": { "type": "boolean" },
        "dataset": { "enum": ["operational", "historical_test", "fixture", "replay", "backfill_test"] },
        "target": {
          "type": "object",
          "required": ["prediction_field", "actual_field", "error_field", "unit", "error_formula"],
          "properties": {
            "prediction_field": { "const": "expected_return" },
            "actual_field": { "const": "session_return" },
            "error_field": { "const": "error" },
            "unit": { "const": "percentage_points" },
            "error_formula": { "const": "session_return - expected_return" }
          },
          "additionalProperties": false
        },
        "display_policy": {
          "type": "object",
          "required": ["expected_open", "expected_close", "expected_return"],
          "properties": {
            "expected_open": { "$ref": "#/$defs/expectedDisplayPolicy" },
            "expected_close": { "$ref": "#/$defs/expectedDisplayPolicy" },
            "expected_return": { "$ref": "#/$defs/expectedDisplayPolicy" }
          },
          "additionalProperties": false
        },
        "sample_count": { "type": "integer", "minimum": 0 },
        "evaluated_sample_count": { "type": "integer", "minimum": 0 },
        "missing_sample_count": { "type": "integer", "minimum": 0 },
        "evaluation_range": {
          "type": "object",
          "required": ["forecast_date", "actual_date", "forecast_stage", "actual_stage", "input_range"],
          "properties": {
            "forecast_date": { "type": ["string", "null"], "format": "date" },
            "actual_date": { "type": ["string", "null"], "format": "date" },
            "forecast_stage": { "type": "string", "pattern": "^\\d{4}$" },
            "actual_stage": { "type": ["string", "null"], "pattern": "^\\d{4}$" },
            "input_range": {
              "type": "object",
              "required": ["start", "end"],
              "properties": {
                "start": { "type": ["string", "null"], "format": "date" },
                "end": { "type": ["string", "null"], "format": "date" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "metrics": {
          "type": "object",
          "required": ["mean_absolute_error", "root_mean_squared_error", "mean_error", "min_error", "max_error"],
          "properties": {
            "mean_absolute_error": { "type": ["number", "null"] },
            "root_mean_squared_error": { "type": ["number", "null"] },
            "mean_error": { "type": ["number", "null"] },
            "min_error": { "type": ["number", "null"] },
            "max_error": { "type": ["number", "null"] }
          },
          "additionalProperties": false
        },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "expectedDisplayPolicy": {
      "type": "object",
      "required": ["source_field", "format", "maximum_fraction_digits", "rounding", "source_precision"],
      "properties": {
        "source_field": { "enum": ["expected_open", "expected_close", "expected_return"] },
        "format": { "const": "number" },
        "maximum_fraction_digits": { "const": 0 },
        "rounding": { "const": "half_up" },
        "source_precision": { "const": "preserved" }
      },
      "additionalProperties": false
    },
    "pipelineStep": {
      "type": "object",
      "required": ["status", "attemptedAt", "provider_id", "message"],
      "properties": {
        "status": { "type": "string" },
        "attemptedAt": { "type": ["string", "null"], "format": "date-time" },
        "provider_id": { "type": ["string", "null"] },
        "message": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "rankingRow": {
      "type": "object",
      "required": ["rank", "symbol", "name", "expected_open", "expected_close", "expected_return", "actual_open", "actual_close", "actual_return", "error", "status"],
      "properties": {
        "rank": { "type": ["integer", "null"], "minimum": 1 },
        "symbol": { "type": ["string", "null"] },
        "name": { "type": ["string", "null"] },
        "expected_open": { "type": ["number", "null"] },
        "expected_open_source": { "type": "object", "required": ["kind", "recorded_at", "history_dates"], "properties": { "kind": { "enum": ["preopen_quote", "preopen_history", "retrospective_history"] }, "recorded_at": { "type": "string", "format": "date-time" }, "history_dates": { "type": "array", "items": { "type": "string", "format": "date" } } }, "additionalProperties": false },
        "expected_open_basis": {
          "description": "Inputs actually used for expected_open. naver_preopen_quote_open_v1: the pre-open quote open price. prior_3_sessions_open_gap_mean_capped_5pct: prior close x (1 + mean of the two latest open gaps, capped at +/-5%). Requires expected_open_source.",
          "type": "object",
          "required": ["model", "history_dates", "inputs"],
          "properties": {
            "model": { "enum": ["naver_preopen_quote_open_v1", "prior_3_sessions_open_gap_mean_capped_5pct"] },
            "history_dates": { "type": "array", "maxItems": 3, "items": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "format": "date" } },
            "inputs": {
              "type": "object",
              "properties": {
                "open_price": { "type": "number", "exclusiveMinimum": 0 }, "quote_at": { "type": "string", "format": "date-time" }, "market_status": { "const": "PREOPEN" },
                "prior_close_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "format": "date" }, "prior_close": { "type": "number", "exclusiveMinimum": 0 },
                "gaps": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "object", "required": ["date", "open", "previous_date", "previous_close", "ratio"], "properties": { "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "format": "date" }, "open": { "type": "number", "exclusiveMinimum": 0 }, "previous_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "format": "date" }, "previous_close": { "type": "number", "exclusiveMinimum": 0 }, "ratio": { "type": "number" } }, "additionalProperties": false } },
                "mean_gap": { "type": "number" }, "applied_gap": { "type": "number" }, "cap": { "const": 0.05 }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "expected_close": { "type": ["number", "null"] },
        "expected_close_basis": {
          "description": "Inputs actually used for expected_close: expected_open x (1 + mean of the three prior session returns close/open - 1, capped at +/-5%). Present only with a prior_3_sessions_open_gap_mean_capped_5pct opening basis.",
          "type": "object",
          "required": ["model", "history_dates", "inputs"],
          "properties": {
            "model": { "const": "prior_3_sessions_gap_and_session_mean_capped_5pct" },
            "history_dates": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "format": "date" } },
            "inputs": {
              "type": "object",
              "required": ["expected_open", "session_returns", "mean_session_return", "applied_session_return", "cap"],
              "properties": {
                "expected_open": { "type": "number", "exclusiveMinimum": 0 },
                "session_returns": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "object", "required": ["date", "open", "close", "ratio"], "properties": { "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "format": "date" }, "open": { "type": "number", "exclusiveMinimum": 0 }, "close": { "type": "number", "exclusiveMinimum": 0 }, "ratio": { "type": "number" } }, "additionalProperties": false } },
                "mean_session_return": { "type": "number" }, "applied_session_return": { "type": "number" }, "cap": { "const": 0.05 }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "expected_return": { "type": ["number", "null"], "description": "Only expected_close / expected_open - 1 × 100; null when expected_close is unavailable. prior_close is never used for this field." },
        "expected_return_raw": { "type": ["number", "null"], "description": "Optional. Unrounded (expected_close / expected_open - 1) × 100; null when either is unavailable. expected_return (rounded to 2 decimals) is unchanged and remains the evaluation field." },
        "evaluation_score": { "type": ["number", "null"], "minimum": 0, "maximum": 100, "description": "Optional. 종목 평가: mid-rank percentile of expected_return_raw among rows of this snapshot with a value; (L + 0.5 × (E - 1)) / (N - 1) × 100, 50 when N = 1, rounded half up to 3 decimals. Null without expected_return_raw." },
        "evaluation_score_rank": { "type": ["integer", "null"], "minimum": 1, "description": "Optional. Descending competition rank of expected_return_raw (ties share the rank)." },
        "evaluation_score_count": { "type": ["integer", "null"], "minimum": 1, "description": "Optional. N, the number of rows in this snapshot with expected_return_raw." },
        "actual_open": { "type": ["number", "null"] },
        "actual_close": { "type": ["number", "null"] },
        "actual_return": { "type": ["number", "null"] },
        "session_return": { "type": ["number", "null"] },
        "intraday_reference_return": { "type": ["number", "null"] },
        "error": { "type": ["number", "null"], "description": "Only computed after expected_return, actual_open, and actual_close are all finite; otherwise null." },
        "actual_volume": { "type": ["number", "null"], "minimum": 0 },
        "prior_close": { "type": ["number", "null"], "minimum": 0 },
        "prior_close_source": { "const": "naver_polling_close_minus_change", "description": "prior_close = quote close minus the signed polling change; the change is measured against the regular-market reference price. Absent when the change or its direction is missing or inconsistent (prior_close is then null)." },
        "features": {
          "type": ["object", "null"],
          "properties": {
            "previous_return": { "type": ["number", "null"] },
            "momentum": { "type": ["number", "null"] },
            "volatility": { "type": ["number", "null"] },
            "lookback_sessions": { "type": ["integer", "null"], "minimum": 1 }
          },
          "additionalProperties": false
        },
        "confidence": { "type": ["number", "null"] },
        "quality": { "type": ["string", "null"] },
        "quote_at": { "type": ["string", "null"], "format": "date-time" },
        "quote_age_seconds": { "type": ["number", "null"], "minimum": 0 },
        "market_status": { "type": ["string", "null"] },
        "trading_status": { "const": "no_trade_observed", "description": "The source itself reported zero trade (volume 0) for the session; actual prices and error stay null and the row is not an evaluation sample." },
        "no_trade_evidence": {
          "type": "object",
          "required": ["source", "reason"],
          "properties": {
            "source": { "enum": ["naver_polling_quote", "naver_daily_candle", "naver_daily_history"] },
            "trade_stop_type": { "type": ["string", "null"] },
            "tradable_status": { "type": ["string", "null"] },
            "tradable_status_code": { "type": ["string", "null"] },
            "volume": { "const": 0 },
            "observed_at": { "type": "string", "format": "date-time" },
            "dates": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "format": "date" } },
            "reason": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "status": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "required": ["expected_open_source"] },
          "then": { "properties": { "expected_open": { "type": "number", "exclusiveMinimum": 0 }, "expected_open_source": { "allOf": [
            { "if": { "properties": { "kind": { "const": "preopen_quote" } }, "required": ["kind"] }, "then": { "properties": { "history_dates": { "maxItems": 0 } } }, "else": { "properties": { "history_dates": { "minItems": 3, "maxItems": 3, "items": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "format": "date" } } } } }
          ] } } }
        },
        { "if": { "required": ["expected_open_basis"] }, "then": { "required": ["expected_open_source"] } },
        { "if": { "required": ["expected_close_basis"] }, "then": { "required": ["expected_open_basis"], "properties": { "expected_close": { "type": "number", "exclusiveMinimum": 0 }, "expected_open_basis": { "properties": { "model": { "const": "prior_3_sessions_open_gap_mean_capped_5pct" } } } } } },
        {
          "if": { "properties": { "expected_close": { "type": "null" } } },
          "then": { "properties": { "expected_return": { "type": "null" } } }
        },
        {
          "if": {
            "anyOf": [
              { "properties": { "expected_return": { "type": "null" } } },
              { "properties": { "actual_open": { "type": "null" } } },
              { "properties": { "actual_close": { "type": "null" } } }
            ]
          },
          "then": { "properties": { "error": { "type": "null" } } }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
